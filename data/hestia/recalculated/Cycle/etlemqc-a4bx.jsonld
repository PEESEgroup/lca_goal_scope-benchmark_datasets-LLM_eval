{"@context": "https://www-staging.hestia.earth/schema/Cycle.jsonld", "createdAt": "2024-05-02", "updatedAt": "2025-04-25", "@id": "etlemqc-a4bx", "@type": "Cycle", "description": "Annual cycle of sedentary lamb farm in Albarracin (no transhumance)", "endDate": "2009", "startDateDefinition": "one year prior", "cycleDuration": 365, "functionalUnit": "relative", "functionalUnitDetails": "Annual production", "site": {"@type": "Site", "@id": "uaperoy_u-jl"}, "siteArea": 176.36363636363637, "siteDuration": 274, "siteUnusedDuration": 91, "otherSites": [{"@type": "Site", "@id": "i6d34loh9gs9"}], "otherSitesDuration": [91], "otherSitesUnusedDuration": [274], "defaultSource": {"@id": "av57dkzgzdv6", "@type": "Source"}, "defaultMethodClassification": "non-verified survey data", "defaultMethodClassificationDescription": "The selected farms were analyzed by field investigation, through several visits and personal interviews with farmers. Structured farmer surveys were conducted that allowed the quantification of main farm inputs, such as feeds and forages used, or fuel consumption, as well as the obtention of a precise description of the herd structure (animal classes), productivity parameters (e.g., replacement rate, lamb mortality rate), and main management practices (e.g., grazing practices, manure management, transhumance type, and period). Farm outputs such as lambs sold, culled sheep, or wool produced were registered from the information gathered in the survey, together with average price received by farmers from the different co-products.", "inputs": [{"term": {"@type": "Term", "termType": "fuel", "name": "Diesel", "units": "kg", "@id": "diesel"}, "value": [440.993], "operation": {"@type": "Term", "name": "Machinery use, operation unspecified", "termType": "operation", "@id": "machineryUseOperationUnspecified", "units": "hour"}, "@type": "Input"}, {"@type": "Input", "term": {"@type": "Term", "@id": "machineryInfrastructureDepreciatedAmountPerCycle", "name": "Machinery inf