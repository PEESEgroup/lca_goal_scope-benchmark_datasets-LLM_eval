{"@context": "https://www-staging.hestia.earth/schema/Cycle.jsonld", "createdAt": "2024-05-02", "updatedAt": "2025-04-25", "@id": "lyj0zylliu9s", "@type": "Cycle", "description": "Annual cycle of transhumant lamb farm in Albarracin (transhumance of herd to summer farm carried out by truck)", "endDate": "2009", "startDateDefinition": "one year prior", "cycleDuration": 365, "functionalUnit": "relative", "functionalUnitDetails": "Annual production", "site": {"@type": "Site", "@id": "o3uu4jq9gfcu"}, "siteArea": 103.41945773524722, "defaultSource": {"@id": "av57dkzgzdv6", "@type": "Source"}, "defaultMethodClassification": "non-verified survey data", "defaultMethodClassificationDescription": "The selected farms were analyzed by field investigation, through several visits and personal interviews with farmers. Structured farmer surveys were conducted that allowed the quantification of main farm inputs, such as feeds and forages used, or fuel consumption, as well as the obtention of a precise description of the herd structure (animal classes), productivity parameters (e.g., replacement rate, lamb mortality rate), and main management practices (e.g., grazing practices, manure management, transhumance type, and period). Farm outputs such as lambs sold, culled sheep, or wool produced were registered from the information gathered in the survey, together with average price received by farmers from the different co-products.", "inputs": [{"term": {"@type": "Term", "termType": "fuel", "name": "Diesel", "units": "kg", "@id": "diesel"}, "value": [146.71], "operation": {"@type": "Term", "name": "Machinery use, operation unspecified", "termType": "operation", "@id": "machineryUseOperationUnspecified", "units": "hour"}, "@type": "Input"}, {"term": {"@type": "Term", "termType": "fuel", "name": "Diesel", "units": "kg", "@id": "diesel"}, "value": [91.478], "operation": {"@type": "Term", "name": "Transporting animals between sites", "termType": "operation", "@id": "transportingAnimalsBetwee