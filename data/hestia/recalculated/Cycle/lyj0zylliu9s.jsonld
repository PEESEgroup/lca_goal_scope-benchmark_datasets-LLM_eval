ype": "Term", "@id": "liveweightPerHead", "name": "Liveweight per head", "termType": "property", "units": "kg liveweight / head"}, "methodModel": {"@type": "Term", "@id": "ipcc2019", "name": "IPCC (2019)", "termType": "model"}, "value": 40.0, "added": ["term", "methodModel", "value"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Property", "term": {"@type": "Term", "@id": "weightAtMaturity", "name": "Weight at maturity", "termType": "property", "units": "kg liveweight / head"}, "methodModel": {"@type": "Term", "@id": "ipcc2019", "name": "IPCC (2019)", "termType": "model"}, "value": 40.0, "added": ["term", "methodModel", "value"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0"]}], "@type": "Animal", "updated": ["inputs", "properties"], "updatedVersion": ["0.70.0", "0.70.0"]}, {"term": {"@type": "Term", "termType": "liveAnimal", "name": "Sheep, lamb", "units": "number", "@id": "sheepLamb"}, "animalId": "Lamb", "value": 41.58657534246575, "referencePeriod": "average", "methodClassification": "estimated with assumptions", "methodClassificationDescription": "Estimated from the number of ewes given in study, using the replacement rate and the no. lambs sold/ewe. The lambs for slaughter are time-corrected using an estimated slaughter age (based on slaughter weight) of 90 days, whilst the lambs destined for replacement are assumed to live all year round. The final value has been adjusted for mortality (i.e. an average of the starting and ending number accounting for the deaths that occur inbetween).", "properties": [{"term": {"@type": "Term", "name": "Mortality rate", "termType": "property", "@id": "mortalityRate", "units": "%"}, "value": 10, "share": 100, "@type": "Property"}, {"term": {"@type": "Term", "name": "Slaughter age", "termType": "property", "@id": "slaughterAge", "units": "days"}, "value": 90, "methodClassification": "estimated with assumptions", "methodClassificationDescription": "Estimated slaughter age of 90 days based on slaughter weight of 26kg.", "share": 100, "@type": "Property"}, {"@type": "Property", "term": {"@type": "Term", "@id": "liveweightPerHead", "name": "Liveweight per head", "termType": "property", "units": "kg liveweight / head"}, "methodModel": {"@type": "Term", "@id": "ipcc2019", "name": "IPCC (2019)", "termType": "model"}, "value": 20.0, "added": ["term", "methodModel", "value"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Property", "term": {"@type": "Term", "@id": "weightAtMaturity", "name": "Weight at maturity", "termType": "property", "units": "kg liveweight / head"}, "methodModel": {"@type": "Term", "@id": "ipcc2019", "name": "IPCC (2019)", "termType": "model"}, "value": 40.0, "added": ["term", "methodModel", "value"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0"]}], "inputs": [{"term": {"@type": "Term", "name": "Concentrate feed blend", "termType": "processedFood", "@id": "concentrateFeedBlend", "units": "kg"}, "isAnimalFeed": true, "value": [41.58657534246575], "methodClassification": "estimated with assumptions", "methodClassificationDescription": "For the lamb feeds (forage, straw and concentrate), we have assumed that the total annual intake values provided in the study are equal to what a lamb would consume if alive for a full year i.e. these values do not take into account that slaughter and mortality cut their lifespan shorter (these are taken into account in the average number of lambs, and therefore will be incorporated into total feed intake for all lambs).", "properties": [{"term": {"@type": "Term", "name": "Dry matter", "termType": "property", "@id": "dryMatter", "units": "%"}, "value": 100, "share": 100, "@type": "Property"}, {"@type": "Property", "term": {"@type": "Term", "@id": "crudeProteinContent", "name": "Crude protein content", "termType": "property", "units": "%"}, "value": 22.27, "added": ["term", "value"], "addedVersion": ["0.70.0", "0.70.0"]}, {"@type": "Property", "term": {"@type": "Term", "@id": "energyContentHigherHeatingValue", "name": "