{"@context": "https://www-staging.hestia.earth/schema/Cycle.jsonld", "createdAt": "2024-01-10", "updatedAt": "2025-04-25", "@id": "f9kytrfcbtfw", "@type": "Cycle", "description": "Production cycle from sheep flock of low genetic merit (ewes in the bottom 20% of animals for the replacement index bred with rams in the bottom 20% of both replacement and terminal indices).", "startDateDefinition": "one year prior", "endDate": "2020", "cycleDuration": 365, "functionalUnit": "relative", "functionalUnitDetails": "Annual production from the whole farm", "site": {"@type": "Site", "@id": "cn3chbbqleue"}, "siteDuration": 274, "siteUnusedDuration": 91, "siteArea": 20, "otherSites": [{"@type": "Site", "@id": "w8xaxlq_rvyw"}], "otherSitesDuration": [91], "otherSitesUnusedDuration": [274], "defaultSource": {"@id": "zbwr_kpj1nsn", "@type": "Source"}, "defaultMethodClassification": "modelled", "defaultMethodClassificationDescription": "An established bio-economic model of Irish lowland sheep flock, the Teagasc Lamb Production Model (TLPM; Bohan et al., 2016) was used. Key model inputs included animal production data, market prices for sheep and wool sales, market prices for variable and fixed costs, stocking rate, and fertiliser use. Production values assumed for animals divergent in genetic merit in this study were derived from the Irish national sheep production data- base, using 387,580 production records from animals born between 2018 and 2020 in commericial flocks in the Irish Central Progeny Test programme (McHugh et al., 2022). Key model outputs included stock inventories, production at a whole farm level, total income and expenses, farm gross margin, and net profit expressed on either a whole farm, per ha, per ewe, or per lamb born basis.", "inputs": [{"term": {"@type": "Term", "name": "Inorganic Nitrogen fertiliser, unspecified (kg N)", "termType": "inorganicFertiliser", "@id": "inorganicNitrogenFertiliserUnspecifiedKgN", "units": "kg N"}, "value": [2000], "@type": "Input"}, {"term": {"@type": "Term", "name": "Inorganic Phosphorus fertiliser, unspecified (kg P2O5)", "termType": "inorganicFertiliser", "@id": "inorganicPhosphorusFertiliserUnspecifiedKgP2O5", "units": "kg P2O5"}, "value": [200], "methodClassification": "estimated with assumptions", "methodClassificationDescription": "\"Phosphorus applied\" assumed to be given in kg P2O5.", "@type": "Input"}, {"term": {"@type": "Term", "name": "Inorganic Potassium fertiliser, unspecified (kg K2O)", "termType": "inorganicFertiliser", "@id": "inorganicPotassiumFertiliserUnspecifiedKgK2O", "units": "kg K2O"}, "value": [400], "methodClassification": "estimated with assumptions", "methodClassificationDescription": "\"Potassium applied\" assumed to be given in kg K2O.", "@type": "Input"}, {"term": {"@type": "Term", "name": "Generic grass, fresh forage", "termType": "forage", "@id": "genericGrassFreshForage", "units": "kg"}, "value": [109825], "producedInCycle": true, "isAnimalFeed": true, "properties": [{"term": {"@type": "Term", "name": "Dry matter", "termType": "property", "@id": "dryMatter", "units": "%"}, "value": 100, "share": 100, "@type": "Property"}, {"@type": "Property", "term": {"@type": "Term", "@id": "acidDetergentFibreContent", "name": "Acid detergent fibre content", "termType": "property", "units": "%"}, "value": 38.15, "added": ["term", "value"], "addedVersion": ["0.70.0", "0.70.0"]}, {"@type": "Property", "term": {"@type": "Term", "@id": "ashContent", "name": "Ash content", "termType": "property", "units": "%"}, "value": 9.98, "added": ["term", "value"], "addedVersion": ["0.70.0", "0.70.0"]}, {"@type": "Property", "term": {"@type": "Term", "@id": "calciumContent", "name": "Calcium content", "termType": "property", "units": "%"}, "value": 0.58, "added": ["term", "value"], "addedVersion": ["0.70.0", "0.70.0"]}, {"@type": "Property", "term": {"@type": "Term", "@id": "copperContent", "name": "Copper content", "termType": "property", "units": "%"}, "value": 0.0, "added": ["term", "va