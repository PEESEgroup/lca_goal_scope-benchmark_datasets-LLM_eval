{"@context": "https://www-staging.hestia.earth/schema/Cycle.jsonld", "createdAt": "2024-01-17", "updatedAt": "2025-04-25", "@id": "7xqclmel8dxz", "@type": "Cycle", "description": "Average production data from 19 suckler calf-to-beef finishing farms participating in the Teagasc/Irish Farmers Journal BETTER farm imrovement programme", "startDateDefinition": "one year prior", "endDate": "2017", "cycleDuration": 365, "functionalUnit": "relative", "site": {"@type": "Site", "@id": "kvhpbhdd8d7x"}, "siteArea": 1, "siteDuration": 249, "siteUnusedDuration": 116, "otherSites": [{"@type": "Site", "@id": "gu-rocixmhi3"}], "otherSitesDuration": [116], "otherSitesUnusedDuration": [249], "defaultSource": {"@id": "6i6cxrp72yp8", "@type": "Source"}, "defaultMethodClassification": "physical measurement", "defaultMethodClassificationDescription": "Physical data pertaining to; suckler cow reproductive performance, progeny pre-weaning growth performance, slaughter characteristics, lifetime carcass gain per day and beef live weight output, were recorded on farm, and in the case of slaughter data, by the abattoir. This data was recorded on the Irish Cattle Breeding Federation (ICBF) central data- base (ICBF, 2017b) from where it was extracted for the purposes of this study. Financial data were recorded by each farmer, in conjunction with their agricultural advisor, using the Teagasc eProfit Monitor software system (Teagasc, 2016). This included gross output, direct and fixed costs of production, gross margin and net margin on a per hectare (ha) and per livestock unit (LU) basis.", "inputs": [{"term": {"@type": "Term", "name": "Inorganic Nitrogen fertiliser, unspecified (kg N)", "termType": "inorganicFertiliser", "@id": "inorganicNitrogenFertiliserUnspecifiedKgN", "units": "kg N"}, "value": [151], "@type": "Input"}, {"term": {"@type": "Term", "termType": "organicFertiliser", "name": "Slurry and sludge (kg N)", "units": "kg N", "@id": "slurryAndSludgeKgN"}, "value": [158], "description": "T