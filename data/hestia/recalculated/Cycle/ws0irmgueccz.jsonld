{"@context": "https://www-staging.hestia.earth/schema/Cycle.jsonld", "createdAt": "2024-01-10", "updatedAt": "2025-04-25", "@id": "ws0irmgueccz", "@type": "Cycle", "description": "Slaughter Cycle for Low genetic merit lambs", "endDate": "2020", "functionalUnit": "relative", "site": {"@type": "Site", "@id": "cxrqnqnu6um9"}, "defaultSource": {"@id": "zbwr_kpj1nsn", "@type": "Source"}, "defaultMethodClassification": "modelled", "defaultMethodClassificationDescription": "An established bio-economic model of Irish lowland sheep flock, the Teagasc Lamb Production Model (TLPM; Bohan et al., 2016) was used. Key model inputs included animal production data, market prices for sheep and wool sales, market prices for variable and fixed costs, stocking rate, and fertiliser use. Production values assumed for animals divergent in genetic merit in this study were derived from the Irish national sheep production data- base, using 387,580 production records from animals born between 2018 and 2020 in commericial flocks in the Irish Central Progeny Test programme (McHugh et al., 2022). Key model outputs included stock inventories, production at a whole farm level, total income and expenses, farm gross margin, and net profit expressed on either a whole farm, per ha, per ewe, or per lamb born basis.", "inputs": [{"term": {"@type": "Term", "termType": "liveAnimal", "name": "Sheep, lamb", "units": "number", "@id": "sheepLamb"}, "value": [220], "impactAssessment": {"@id": "xk8stv3evol8", "@type": "ImpactAssessment"}, "impactAssessmentIsProxy": false, "properties": [{"term": {"@type": "Term", "name": "Liveweight per head", "termType": "property", "@id": "liveweightPerHead", "units": "kg liveweight / head"}, "value": 43, "share": 100, "@type": "Property"}], "@type": "Input"}], "products": [{"term": {"@type": "Term", "termType": "animalProduct", "name": "Meat, sheep (cold carcass weight)", "units": "kg cold carcass weight", "@id": "meatSheepColdCarcassWeight"}, "value": [4505.6], "primary": tr