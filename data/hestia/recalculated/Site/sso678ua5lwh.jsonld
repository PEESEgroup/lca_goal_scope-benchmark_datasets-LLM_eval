{"@context": "https://www-staging.hestia.earth/schema/Site.jsonld", "createdAt": "2024-05-08", "updatedAt": "2025-04-25", "@id": "sso678ua5lwh", "@type": "Site", "defaultSource": {"@id": "zbwr_kpj1nsn", "@type": "Source"}, "siteType": "permanent pasture", "country": {"@type": "Term", "@id": "GADM-IRL", "name": "Ireland", "termType": "region"}, "area": 20, "organisation": {"@id": "kteg_pqjkyxd", "@type": "Organisation"}, "defaultMethodClassification": "modelled", "defaultMethodClassificationDescription": "An established bio-economic model of Irish lowland sheep flock, the Teagasc Lamb Production Model (TLPM; Bohan et al., 2016) was used. Key model inputs included animal production data, market prices for sheep and wool sales, market prices for variable and fixed costs, stocking rate, and fertiliser use. Production values assumed for animals divergent in genetic merit in this study were derived from the Irish national sheep production data- base, using 387,580 production records from animals born between 2018 and 2020 in commericial flocks in the Irish Central Progeny Test programme (McHugh et al., 2022). Key model outputs included stock inventories, production at a whole farm level, total income and expenses, farm gross margin, and net profit expressed on either a whole farm, per ha, per ewe, or per lamb born basis.", "management": [{"term": {"@type": "Term", "termType": "landCover", "name": "Improved pasture", "units": "% area", "@id": "improvedPasture"}, "value": 100, "endDate": "2020", "@type": "Management"}, {"@type": "Management", "term": {"@type": "Term", "@id": "permanentPasture", "name": "Permanent pasture", "termType": "landCover", "units": "% area"}, "value": 100, "endDate": "2020-12-31", "added": ["term", "value", "endDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "pastureGrass", "name": "Pasture grass", "termType": "landUseManagement", "units": "% area"}, "value": 100, "endDate": "2020-12-31", "startDate": "2020-01-01", "added": ["term", "value", "endDate", "startDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "confinedPastureSystem", "name": "Confined pasture system", "termType": "system", "units": "%"}, "value": 75.06849315068493, "endDate": "2020-12-31", "startDate": "2020-01-01", "added": ["term", "value", "endDate", "startDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "indoorAnimalSystem", "name": "Indoor animal system", "termType": "system", "units": "%"}, "value": 24.93150684931507, "endDate": "2020-12-31", "startDate": "2020-01-01", "added": ["term", "value", "endDate", "startDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "forest", "name": "Forest", "termType": "landCover", "units": "% area"}, "model": {"@type": "Term", "@id": "hestia", "name": "HESTIA", "termType": "model"}, "value": 0, "startDate": "2000-01-01", "endDate": "2000-12-31", "added": ["term", "model", "value", "startDate", "endDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "annualCropland", "name": "Annual cropland", "termType": "landCover", "units": "% area"}, "model": {"@type": "Term", "@id": "hestia", "name": "HESTIA", "termType": "model"}, "value": 1.08, "startDate": "2000-01-01", "endDate": "2000-12-31", "added": ["term", "model", "value", "startDate", "endDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "permanentCropland", "name": "Permanent cropland", "termType": "landCover", "units": "% area"}, "model": {"@type": "Term", "@id": "hestia", "name": "HESTIA", "termType": "model"}, "value": 0.0246, "startDate": "2000-01-01", "endDate": "2000-12-31", "added": ["term", "model", "val