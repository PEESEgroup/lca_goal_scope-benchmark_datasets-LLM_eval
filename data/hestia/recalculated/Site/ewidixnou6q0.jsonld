74p2kj", "name": "IPCC (2006)", "added": ["@id", "name"], "addedVersion": ["0.70.0", "0.70.0"]}], "added": ["term", "method", "value", "sd", "min", "max", "statsDefinition", "observations", "dates", "methodClassification", "depthUpper", "depthLower", "source", "otherSources"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Measurement", "term": {"@type": "Term", "@id": "organicCarbonPerHa", "name": "Organic carbon (per ha)", "termType": "measurement", "units": "kg C / ha"}, "method": {"@type": "Term", "@id": "ipcc2019", "name": "IPCC (2019)", "termType": "model"}, "value": [18985.606578], "sd": [1556.213883], "min": [13282.701644], "max": [24860.758945], "statsDefinition": "simulated", "observations": [10000], "dates": ["2009-12-31"], "depthUpper": 0, "depthLower": 30, "methodClassification": "tier 1 model", "added": ["term", "method", "value", "sd", "min", "max", "statsDefinition", "observations", "dates", "depthUpper", "depthLower", "methodClassification"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0"]}], "area": 128.548644338118, "defaultMethodClassification": "non-verified survey data", "defaultMethodClassificationDescription": "The selected farms were analyzed by field investigation, through several visits and personal interviews with farmers, involving an accompanying walk during their journey in the case of herds that practiced transhumance on foot. The latter was done to make sure selected herds were actually migrating on foot. Building on such opportunities, structured farmer surveys were conducted that allowed the quantification of main farm inputs, such as feeds and forages used, or fuel consumption, as well as the obtention of a precise description of the herd structure (animal classes), productivity parameters (e.g., replacement rate, lamb mortality rate), and main management practices (e.g., grazing practices, manure management, transhumance type, and period). Farm outputs such as lambs sold, culled sheep, or wool produced were registered from the information gathered in the survey, together with average price received by farmers from the different co-products.", "management": [{"term": {"@type": "Term", "termType": "landCover", "name": "Native pasture", "units": "% area", "@id": "nativePasture"}, "value": 100, "endDate": "2009", "@type": "Management"}, {"@type": "Management", "term": {"@type": "Term", "@id": "permanentPasture", "name": "Permanent pasture", "termType": "landCover", "units": "% area"}, "value": 100, "endDate": "2009-12-31", "added": ["term", "value", "endDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "pastureGrass", "name": "Pasture grass", "termType": "landUseManagement", "units": "% area"}, "value": 100, "endDate": "2009-12-31", "startDate": "2008-12-31", "added": ["term", "value", "endDate", "startDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "hillyPastureSystem", "name": "Hilly pasture system", "termType": "system", "units": "%"}, "value": 100, "endDate": "2009-12-31", "startDate": "2008-12-31", "added": ["term", "value", "endDate", "startDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "forest", "name": "Forest", "termType": "landCover", "units": "% area"}, "model": {"@type": "Term", "@id": "hestia", "name": "HESTIA", "termType": "model"}, "value": 0, "startDate": "1989-01-01", "endDate": "1989-12-31", "added": ["term", "model", "value", "startDate", "endDate"], "addedVersion": ["0.70.0", "0.70.0", "0.70.0", "0.70.0", "0.70.0"]}, {"@type": "Management", "term": {"@type": "Term", "@id": "annualCropland", "name": "Annual cropland", "termType": "landCover", "units": "% 