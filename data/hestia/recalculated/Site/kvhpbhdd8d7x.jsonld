{"@context": "https://www-staging.hestia.earth/schema/Site.jsonld", "createdAt": "2024-01-17", "updatedAt": "2025-04-25", "@id": "kvhpbhdd8d7x", "@type": "Site", "defaultSource": {"@id": "6i6cxrp72yp8", "@type": "Source"}, "siteType": "permanent pasture", "country": {"@type": "Term", "@id": "GADM-IRL", "name": "Ireland", "termType": "region"}, "numberOfSites": 19, "area": 61, "organisation": {"@id": "r9fnh22ridds", "@type": "Organisation"}, "defaultMethodClassification": "physical measurement", "defaultMethodClassificationDescription": "Physical data pertaining to; suckler cow reproductive performance, progeny pre-weaning growth performance, slaughter characteristics, lifetime carcass gain per day and beef live weight output, were recorded on farm, and in the case of slaughter data, by the abattoir. This data was recorded on the Irish Cattle Breeding Federation (ICBF) central data- base (ICBF, 2017b) from where it was extracted for the purposes of this study. Financial data were recorded by each farmer, in conjunction with their agricultural advisor, using the Teagasc eProfit Monitor software system (Teagasc, 2016). This included gross output, direct and fixed costs of production, gross margin and net margin on a per hectare (ha) and per livestock unit (LU) basis.", "management": [{"term": {"@type": "Term", "termType": "landCover", "name": "Improved pasture", "units": "% area", "@id": "improvedPasture"}, "value": 100, "methodClassification": "physical measurement", "methodClassificationDescription": "Physical data pertaining to; suckler cow reproductive performance, progeny pre-weaning growth performance, slaughter characteristics, lifetime carcass gain per day and beef live weight output, were recorded on farm, and in the case of slaughter data, by the abattoir. This data was recorded on the Irish Cattle Breeding Federation (ICBF) central data- base (ICBF, 2017b) from where it was extracted for the purposes of this study. Financial data were recorded by each farmer