      "animalId": "Lamb",
      "value": 133.6376712328767,
      "referencePeriod": "average",
      "methodClassification": "estimated with assumptions",
      "methodClassificationDescription": "Estimated from the number of ewes given in study, using the replacement rate and the no. lambs sold/ewe. The lambs for slaughter are time-corrected using an estimated slaughter age (based on slaughter weight) of 90 days, whilst the lambs destined for replacement are assumed to live all year round. The final value has been adjusted for mortality (i.e. an average of the starting and ending number accounting for the deaths that occur inbetween).",
      "properties": [
        {
          "term": {
            "@type": "Term",
            "name": "Mortality rate",
            "termType": "property",
            "@id": "mortalityRate",
            "units": "%"
