            "name": "Slaughter age",
            "termType": "property",
            "@id": "slaughterAge",
            "units": "days"
          },
          "value": 90,
          "methodClassification": "estimated with assumptions",
          "methodClassificationDescription": "Estimated slaughter age of 90 days based on slaughter weight of 26kg.",
          "share": 100,
          "@type": "Property"
        }
      ],
      "inputs": [
        {
          "term": {
